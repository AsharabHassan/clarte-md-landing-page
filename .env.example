# ───────────────────────────────────────────────────────────────────
#  Clarté MD — environment variables template
#  Copy to .env.local and fill in the values.
#  NEVER commit .env.local (it is gitignored).
# ───────────────────────────────────────────────────────────────────

# ── Supabase (Settings → API) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Postgres (Settings → Database → Connection string → Transaction pooler, port 6543) ──
# URL-encode any special characters in the password (@ → %40, / → %2F, etc.)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Google AI (Gemini) — https://aistudio.google.com/apikey ───────
GEMINI_API_KEY=

# ── App secrets ────────────────────────────────────────────────────
# 32-byte random hex (generate with: openssl rand -hex 32)
IP_HASH_PEPPER=replace-with-32-byte-random-hex
CRON_SECRET=replace-with-32-byte-random-hex

# ── Admin seed user (used once by lib/db/seed.ts) ──────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Existing analytics (already wired into acne-protocol.html) ─────
NEXT_PUBLIC_GTM_ID=GTM-P8VD7TBS

# ── Application ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
