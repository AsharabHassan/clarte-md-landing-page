# ───────────────────────────────────────────────────────────────────
#  Clarté MD — environment variables template
#  Copy to .env.local and fill in the values.
#  NEVER commit .env.local (it is gitignored).
# ───────────────────────────────────────────────────────────────────

# ── Supabase (Settings → API) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Postgres (Settings → Database → Connection string → Transaction pooler, port 6543) ──
# URL-encode any special characters in the password (@ → %40, / → %2F, etc.)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Google AI (Gemini) — https://aistudio.google.com/apikey ───────
GEMINI_API_KEY=

# ── App secrets ────────────────────────────────────────────────────
# 32-byte random hex (generate with: openssl rand -hex 32)
IP_HASH_PEPPER=replace-with-32-byte-random-hex
CRON_SECRET=replace-with-32-byte-random-hex

# Signs the customer portal (/account) session cookie. Optional —
# falls back to IP_HASH_PEPPER if unset. Set its own value in prod.
PORTAL_SESSION_SECRET=

# ── Admin seed user (used once by lib/db/seed.ts) ──────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Existing analytics (already wired into acne-protocol.html) ─────
NEXT_PUBLIC_GTM_ID=GTM-P8VD7TBS

# ── Application ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sub-project #3: Automation webhooks ────────────────────────────
# Each fires a JSON POST when its event happens. Leave blank to skip.
# Recommended: wire each to one Zapier / Make.com / n8n flow that
# fans out from there to your CRM, SMS, email, WhatsApp providers.
# Payload schemas in docs/runbooks/2026-05-17-automation-webhooks.md

WEBHOOK_ORDER_CREATED=
WEBHOOK_ORDER_CONFIRMED=
WEBHOOK_ORDER_DISPATCHED=
WEBHOOK_ORDER_DELIVERED=
WEBHOOK_ORDER_CANCELLED=
WEBHOOK_ORDER_REFUNDED=
WEBHOOK_CONTACT_SUBMITTED=
# Fires when a visitor submits the name/email/phone gate before an AI scan
# result (quiz + protocol projections). Point this at the GHL/LeadConnector
# lead-capture hook. Payload: { event:'lead.captured', lead:{ name,email,phone,
# surface, concern, ai_session_id, source_url } }
WEBHOOK_LEAD_CAPTURED=
# Per-concern AI-scan lead webhooks. Each of the four protocol scans posts to
# its own hook so GHL can route the lead straight into the matching nurture
# track with no branching. Quiz leads stay on WEBHOOK_LEAD_CAPTURED above.
# Leave any blank to fall back to WEBHOOK_LEAD_CAPTURED.
WEBHOOK_LEAD_ACNE=
WEBHOOK_LEAD_PIGMENTATION=
WEBHOOK_LEAD_AGEING=
WEBHOOK_LEAD_BARRIER=
